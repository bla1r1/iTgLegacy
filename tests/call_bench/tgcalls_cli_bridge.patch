+// ---------------------------------------------------------------------------
+// Bridge mode: one real Instance against an outside client. Signaling goes over a
+// localhost TCP socket as big-endian length + bytes. Prints what it heard, so a
+// silent direction shows as a number rather than as a guess.
+// ---------------------------------------------------------------------------
+
+class ToneMeter : public tgcalls::FakeAudioDeviceModule::Renderer {
+public:
+    bool Render(const tgcalls::AudioFrame& frame) override {
+        const size_t step = frame.num_channels ? frame.num_channels : 1;
+        double energy = 0;
+        double g1000[2] = {0, 0}, g440[2] = {0, 0}, g800[2] = {0, 0};
+        const double c1000 = 2.0 * std::cos(2.0 * M_PI * 1000.0 / 48000.0);
+        const double c440 = 2.0 * std::cos(2.0 * M_PI * 440.0 / 48000.0);
+        const double c800 = 2.0 * std::cos(2.0 * M_PI * 800.0 / 48000.0);
+        for (size_t i = 0; i < frame.num_samples; ++i) {
+            const double s = frame.audio_samples[i * step];
+            energy += s * s;
+            double next = s + c1000 * g1000[0] - g1000[1];
+            g1000[1] = g1000[0];
+            g1000[0] = next;
+            next = s + c440 * g440[0] - g440[1];
+            g440[1] = g440[0];
+            g440[0] = next;
+            next = s + c800 * g800[0] - g800[1];
+            g800[1] = g800[0];
+            g800[0] = next;
+        }
+        const double n = frame.num_samples ? double(frame.num_samples) : 1.0;
+        // Goertzel power as a share of the frame's energy: 1.0 is a pure tone.
+        const double p1000 = (g1000[0] * g1000[0] + g1000[1] * g1000[1] - c1000 * g1000[0] * g1000[1]) * 2.0 / n;
+        const double p440 = (g440[0] * g440[0] + g440[1] * g440[1] - c440 * g440[0] * g440[1]) * 2.0 / n;
+        const double p800 = (g800[0] * g800[0] + g800[1] * g800[1] - c800 * g800[0] * g800[1]) * 2.0 / n;
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++frames_;
+        energy_ += energy;
+        power800_ += p800;
+        power1000_ += p1000;
+        power440_ += p440;
+        return true;
+    }
+    void report(const char* state, int mediaStates) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        printf("BRIDGE_RESULT state=%s remote_media_states=%d rx_frames=%lld rx_energy=%.0f share_1000hz=%.2f share_800hz=%.2f share_440hz=%.2f\n",
+               state, mediaStates, frames_, energy_ / 1e6,
+               energy_ > 0 ? power1000_ / energy_ : 0.0, energy_ > 0 ? power800_ / energy_ : 0.0,
+               energy_ > 0 ? power440_ / energy_ : 0.0);
+        fflush(stdout);
+    }
+private:
+    std::mutex mutex_;
+    long long frames_ = 0;
+    double energy_ = 0, power1000_ = 0, power800_ = 0, power440_ = 0;
+};
+
+static std::vector<uint8_t> hexDecode(const std::string& hex) {
+    std::vector<uint8_t> out;
+    for (size_t i = 0; i + 1 < hex.size(); i += 2)
+        out.push_back(static_cast<uint8_t>(std::stoi(hex.substr(i, 2), nullptr, 16)));
+    return out;
+}
+
+static int runBridge(const std::string& version, const std::string& host, uint16_t port,
+                     int duration, int argc, char* argv[]) {
+    bool isOutgoing = false;
+    int signalPort = 0;
+    std::string keyHex, tagHex, logFile;
+    for (int i = 1; i + 1 < argc; ++i) {
+        const std::string name = argv[i];
+        if (name == "--role") isOutgoing = std::string(argv[i + 1]) == "caller";
+        else if (name == "--signal-port") signalPort = std::atoi(argv[i + 1]);
+        else if (name == "--key-hex") keyHex = argv[i + 1];
+        else if (name == "--tag-hex") tagHex = argv[i + 1];
+        else if (name == "--rtc-log") logFile = argv[i + 1];
+    }
+    const auto keyBytes = hexDecode(keyHex);
+    const auto tagBytes = hexDecode(tagHex);
+    if (keyBytes.size() != 256 || tagBytes.size() != 16 || !signalPort) {
+        fprintf(stderr, "bridge: needs --key-hex (256 bytes), --tag-hex (16), --signal-port\n");
+        return 1;
+    }
+    auto keyData = std::make_shared<std::array<uint8_t, 256>>();
+    std::copy(keyBytes.begin(), keyBytes.end(), keyData->begin());
+    std::array<uint8_t, 16> tag{};
+    std::copy(tagBytes.begin(), tagBytes.end(), tag.begin());
+
+    int listener = socket(AF_INET, SOCK_STREAM, 0);
+    int reuse = 1;
+    setsockopt(listener, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    addr.sin_port = htons(static_cast<uint16_t>(signalPort));
+    if (bind(listener, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0 || listen(listener, 1) != 0) {
+        perror("bridge: bind");
+        return 1;
+    }
+    fprintf(stderr, "bridge: waiting for the client on port %d\n", signalPort);
+    int fd = accept(listener, nullptr, nullptr);
+    if (fd < 0) {
+        perror("bridge: accept");
+        return 1;
+    }
+    auto writeMutex = std::make_shared<std::mutex>();
+    auto meter = std::make_shared<ToneMeter>();
+    auto recorder = std::make_shared<SineRecorder>();
+    auto lastState = std::make_shared<std::atomic<int>>(-1);
+    auto mediaStates = std::make_shared<std::atomic<int>>(0);
+
+    tgcalls::Descriptor descriptor = {
+        .version = version,
+        .config = {
+            .initializationTimeout = 30.0,
+            .receiveTimeout = 30.0,
+            .enableP2P = false,
+            .logPath = {logFile},
+        },
+        .rtcServers = std::vector<tgcalls::RtcServer>{makeReflectorServer(host, port, tag)},
+        .encryptionKey = tgcalls::EncryptionKey(keyData, isOutgoing),
+        .stateUpdated = [lastState](tgcalls::State state) {
+            logMsg("Bridge", "state -> %s", stateName(state));
+            lastState->store(static_cast<int>(state));
+        },
+        .remoteMediaStateUpdated = [mediaStates](tgcalls::AudioState audio, tgcalls::VideoState video) {
+            logMsg("Bridge", "remote media state: audio %d video %d", (int)audio, (int)video);
+            mediaStates->fetch_add(1);
+        },
+        .signalingDataEmitted = [fd, writeMutex](const std::vector<uint8_t>& data) {
+            logMsg("Bridge", "signaling out, %zu bytes", data.size());
+            std::lock_guard<std::mutex> lock(*writeMutex);
+            uint32_t size = htonl(static_cast<uint32_t>(data.size()));
+            (void)!write(fd, &size, sizeof(size));
+            (void)!write(fd, data.data(), data.size());
+        },
+        .createAudioDeviceModule = tgcalls::FakeAudioDeviceModule::Creator(
+            meter, recorder,
+            tgcalls::FakeAudioDeviceModule::Options{.samples_per_sec = 48000, .num_channels = 2}),
+    };
+    auto instance = std::shared_ptr<tgcalls::Instance>(
+        tgcalls::Meta::Create(version, std::move(descriptor)).release());
+    if (!instance) {
+        fprintf(stderr, "Error: unknown version '%s'\n", version.c_str());
+        return 1;
+    }
+    std::thread([fd, instance]() {
+        for (;;) {
+            uint32_t size = 0;
+            if (recv(fd, &size, sizeof(size), MSG_WAITALL) != sizeof(size)) return;
+            std::vector<uint8_t> data(ntohl(size));
+            if (recv(fd, data.data(), data.size(), MSG_WAITALL) != (ssize_t)data.size()) return;
+            logMsg("Bridge", "signaling in, %zu bytes", data.size());
+            instance->receiveSignalingData(data);
+        }
+    }).detach();
+
+    std::this_thread::sleep_for(std::chrono::seconds(duration));
+    const int state = lastState->load();
+    meter->report(state >= 0 ? stateName(static_cast<tgcalls::State>(state)) : "none", mediaStates->load());
+    // The process is done; a clean teardown proves nothing here and can hang.
+    _exit(0);
+}
